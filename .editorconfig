root = true

[*]
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h}]
indent_style = space
indent_size = 4
tab_width = 4
end_of_line = lf
charset = utf-8
cpp_brace_style = next_line
cpp_if_brace_style = end_of_line
cpp_else_brace_style = end_of_line
cpp_for_brace_style = end_of_line
cpp_while_brace_style = end_of_line
cpp_do_while_brace_style = end_of_line
cpp_switch_brace_style = end_of_line
